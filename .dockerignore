# Build context excludes.
#
# Required, not tidy: this checkout carries an 8.5 GB .venv, so without this file
# every `docker build` here uploads it before doing anything.
#
# .git is deliberately KEPT (~96 MB) — setuptools_scm derives the package version
# from it, and the install in docker/Dockerfile.* fails without it.
.venv
venv/
/build
/build/
dist
/dist/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

.mypy_cache
.pytest_cache
.ruff_cache

# Distribution / packaging
.Python
cmake-build-*/
CMakeUserPresets.json
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
rust/target/
